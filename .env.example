# Glazion API environment variables (docker compose / Railway service variables).
# Copy to .env for local compose. Never commit real values.

# Local docker compose: password for the bundled Postgres and the first admin
POSTGRES_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD=

# Database (Railway: use the Postgres service's connection values)
ConnectionStrings__GlazionDb=Host=<host>;Port=5432;Database=glazion;Username=<user>;Password=<password>
# Set to false when migrations are applied by a separate step
Database__ApplyMigrationsOnStartup=true

# First admin, created only when no admin exists. Use a strong password outside development.
BootstrapAdmin__Username=admin
BootstrapAdmin__Password=

# Cloudflare R2 (S3 API). ServiceUrl is https://<account-id>.r2.cloudflarestorage.com
R2__ServiceUrl=
R2__Region=auto
R2__AccessKey=
R2__SecretKey=
R2__Bucket=

# Swagger UI at /swagger (always on in Development)
Swagger__Enabled=false

# Background worker (validation, derivatives, indexing). Runs in the API process.
Worker__Enabled=true

# Search. InMemory/Hashing need no keys; switch to Pinecone/OpenAI for production search.
Features__RecipeImageRetrieval=false
VectorIndex__Provider=InMemory
VectorIndex__Pinecone__ApiKey=
VectorIndex__Pinecone__IndexHost=
Embeddings__Provider=Hashing
Embeddings__OpenAI__ApiKey=
