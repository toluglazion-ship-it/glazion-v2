{
  "ConnectionStrings": {
    "GlazionDb": "Host=localhost;Port=5432;Database=glazion;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "Database": { "ApplyMigrationsOnStartup": true },
  "BootstrapAdmin": { "Username": "admin", "Password": "change-me-in-development" },
  "Sessions": { "AccessTokenMinutes": 60, "RefreshTokenDays": 30 },
  "RateLimits": { "CredentialsPerMinute": 20 },
  "Uploads": {
    "MaxBytes": 15728640,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "Ingestion": {
    "QualityPolicyVersion": "quality-policy-v2",
    "MinWidth": 1200,
    "MinHeight": 1200,
    "MaxPixels": 80000000,
    "HeaderBufferBytes": 1048576,
    "AllowedTileVariants": [ "white", "off_white", "pink" ],
    "AllowedAtmospheres": [ "oxidation", "reduction", "neutral" ],
    "MaxImportRecordsPerRequest": 200,
    "ImportHeadConcurrency": 8
  },
  "Derivatives": {
    "Enabled": true,
    "DisplayMaxEdge": 2048,
    "ThumbnailMaxEdge": 400,
    "DisplayQuality": 82,
    "ThumbnailQuality": 75,
    "LosslessMaxEdge": 400,
    "MaxDecodeBytes": 67108864,
    "MetricsEdge": 1024,
    "MinSharpness": 40,
    "MinMeanLuma": 45,
    "MaxDarkFraction": 0.5,
    "MaxClippedFraction": 0.3
  },
  "Worker": {
    "Enabled": true,
    "Concurrency": 4,
    "PollIntervalSeconds": 2,
    "LeaseSeconds": 300,
    "RetryBaseSeconds": 10
  },
  "Chemistry": {
    "DataDirectory": "ChemistryData"
  },
  "Swagger": { "Enabled": false },
  "AiCopies": {
    "Provider": "OpenAI",
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "",
    "Model": "gpt-image-2.5-sunburst",
    "Quality": "high",
    "Size": "1024x1024",
    "OutputCompression": 90,
    "TimeoutSeconds": 240,
    "MaxInFlightPerImage": 1
  },
  "Chat": {
    "Provider": "Disabled",
    "OpenAI": { "BaseUrl": "https://api.openai.com/v1", "ApiKey": "", "Model": "gpt-4o-mini", "Temperature": 0.2, "MaxOutputTokens": 900 },
    "Knowledge": {
      "Provider": "None",
      "PineconeApiKey": "",
      "PineconeIndexHost": "",
      "Namespace": "",
      "Namespaces": "",
      "EmbeddingModel": "text-embedding-3-small",
      "TopK": 5,
      "MinScore": 0.35,
      "HighScore": 0.6
    },
    "HistoryMessages": 12,
    "MaxToolRounds": 4
  },
  "Features": {
    "RecipeImageRetrieval": true
  },
  "Retrieval": {
    "RankerVersion": "hybrid-ranker-1.2.0",
    "Weights": { "Chemistry": 0.55, "Firing": 0.20, "LabelOrText": 0.15, "Image": 0.10, "Colourant": 0.45 },
    "SimilarCount": 8,
    "MinimumConfidence": 0.45,
    "HighConfidence": 0.80,
    "MediumConfidence": 0.60,
    "MinCandidates": 50,
    "CandidateMultiplier": 8,
    "MaxCandidates": 400,
    "MaxTopK": 50,
    "DefaultTopK": 12,
    "ConeTolerance": 1,
    "ChemistryCosineShare": 0.5,
    "MinimumChemistryCoverage": 0.75
  },
  "Embeddings": {
    "Provider": "Hashing",
    "Hashing": { "Dimension": 256 },
    "OpenAI": {
      "BaseUrl": "https://api.openai.com/v1",
      "ApiKey": "",
      "Model": "text-embedding-3-small",
      "Version": "text-embedding-3-small:2026-09",
      "Dimension": 1536,
      "BatchSize": 64,
      "MaxRetries": 4
    }
  },
  "VectorIndex": {
    "Provider": "InMemory",
    "Pinecone": {
      "ApiKey": "",
      "IndexHost": "",
      "NamespaceIndexHosts": {},
      "ChemistryIndexHost": "",
      "TextIndexHost": "",
      "ApiVersion": "2025-01",
      "UpsertBatchSize": 100,
      "MaxRetries": 4,
      "RetryBaseMilliseconds": 500
    }
  },
  "R2": {
    "ServiceUrl": "",
    "Region": "auto",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "",
    "PresignedUploadMinutes": 15,
    "PresignedReadMinutes": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    }
  },
  "AllowedHosts": "*"
}
